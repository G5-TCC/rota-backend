generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  GRATIS
  PRO
}

enum TransactionType {
  PLAN_SUBSCRIPTION
}

model User {
  id                 String            @id @default(dbgenerated("gen_random_uuid()"))
  alias              String            @unique
  email              String            @unique
  password           String
  role               String            @default("FULL")
  plan               Plan              @default(GRATIS)
  isVerified         Boolean           @default(false)
  is2faEnabled       Boolean           @default(false)
  twoFactorCode      String?
  twoFactorExpiresAt DateTime?
  verificationToken  String?           @unique
  sessions           Session[]
  resets             PasswordReset[]
  auditLogs          AuditLog[]
  knownDevices       KnownDevice[]
  transactions       Transaction[]
  createdAt          DateTime          @default(now())
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  ipAddress    String
  userAgent    String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model KnownDevice {
  id                String   @id @default(dbgenerated("gen_random_uuid()"))
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String
  lastUsed          DateTime @default(now())
  createdAt         DateTime @default(now())

  @@unique([userId, deviceFingerprint])
  @@index([userId])
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

model Transaction {
  id         String            @id @default(dbgenerated("gen_random_uuid()"))
  externalId String            @unique
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  status     TransactionStatus @default(PENDING)
  type       TransactionType
  metadata   Json?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
  @@index([externalId])
}
